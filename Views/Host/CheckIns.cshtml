@model List<GuestCheckIn>
@{ ViewData["Title"] = "Guest check-ins"; }
<h3>Guest Check-ins</h3>
<div class="card p-3"><table class="table align-middle mb-0"><thead><tr><th>Guest</th><th>Property</th><th>Stay</th><th>Status</th><th></th></tr></thead><tbody>
@foreach (var c in Model)
{
    <tr><td>@c.Booking.Guest.FullName</td><td>@c.Booking.Property.Title</td><td>@c.Booking.CheckInDate.ToString("yyyy-MM-dd")</td>
        <td><span class="badge @Ui.Badge(c.Status)">@c.Status</span></td><td><a class="btn btn-sm btn-outline-brand" asp-action="CheckInDetail" asp-route-id="@c.Id">Review</a></td></tr>
}
</tbody></table>@if (!Model.Any()) { <p class="text-muted m-2">No check-ins submitted yet.</p> }</div>
