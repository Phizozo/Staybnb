@model HostDashboardVM
@{ ViewData["Title"] = "Host Dashboard"; }
<h3>Host Dashboard</h3>
<div class="card p-4 mb-4"><h5 style="color:var(--brand)">Welcome back, @Model.Name!</h5><div class="text-muted mb-2">Here's what's happening with your properties today.</div>
    <div class="d-flex gap-2 flex-wrap"><a class="btn btn-outline-brand btn-sm" asp-action="AddProperty">+ Add New Property</a><a class="btn btn-outline-brand btn-sm" asp-action="Bookings">View Booking Requests</a><a class="btn btn-outline-brand btn-sm" asp-action="Earnings">View Earnings</a></div></div>
<div class="row g-3 mb-4">
    <div class="col-6 col-lg-3"><div class="card p-3"><div class="stat">@Model.TotalProperties</div>Total Properties<div class="small text-success">@Model.ActiveProperties active</div></div></div>
    <div class="col-6 col-lg-3"><div class="card p-3"><div class="stat">@Model.TotalBookings</div>Total Bookings<div class="small text-warning">@Model.PendingBookings pending</div></div></div>
    <div class="col-6 col-lg-3"><div class="card p-3"><div class="stat">@Ui.Money(Model.TotalEarnings)</div>Total Earnings</div></div>
    <div class="col-6 col-lg-3"><div class="card p-3"><div class="stat">@Ui.Stars(Model.AverageRating)</div>Average Rating<div class="small text-muted">@Model.ReviewCount reviews</div></div></div>
</div>
@if (Model.PendingCheckIns > 0) { <div class="alert alert-warning">@Model.PendingCheckIns guest check-in(s) awaiting document verification. <a asp-action="CheckIns">Review</a></div> }
<div class="card p-3"><h5>Recent bookings</h5>
    <table class="table align-middle mb-0"><thead><tr><th>Guest</th><th>Property</th><th>Dates</th><th>Total</th><th>Status</th></tr></thead><tbody>
    @foreach (var b in Model.Recent) { <tr><td>@b.Guest.FullName</td><td>@b.Property.Title</td><td>@b.CheckInDate.ToString("dd MMM") - @b.CheckOutDate.ToString("dd MMM")</td><td>@Ui.Money(b.TotalPrice)</td><td><span class="badge @Ui.Badge(b.Status)">@b.Status</span></td></tr> }
    </tbody></table></div>
