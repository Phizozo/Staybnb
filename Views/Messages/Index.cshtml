@model List<ConversationVM>
@{ ViewData["Title"] = "Messages"; }
<h3>Inbox</h3>
@if (!Model.Any()) { <p class="text-muted">No conversations yet. Use "Contact host" on a property page to start one.</p> }
<div class="list-group" style="max-width:700px">
@foreach (var c in Model)
{
    <a class="list-group-item list-group-item-action d-flex justify-content-between" asp-action="Thread" asp-route-id="@c.Partner.Id">
        <div><strong>@c.Partner.FullName</strong><div class="small text-muted text-truncate" style="max-width:420px">@c.Last.Content</div></div>
        <div class="text-end small text-muted">@c.Last.Timestamp.ToString("yyyy-MM-dd HH:mm")@if (c.Unread > 0) { <div><span class="badge bg-danger">@c.Unread new</span></div> }</div>
    </a>
}
</div>
