@{
    var isHost = User.IsInRole("Host");
    var isAdmin = User.IsInRole("Admin") || User.IsInRole("SuperAdmin");
    var isGuest = User.IsInRole("Guest");
    var side = isHost || isAdmin;
    var path = Context.Request.Path.Value ?? "";
    string Active(string p) => path.StartsWith(p, StringComparison.OrdinalIgnoreCase) ? "active" : "";
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>@ViewData["Title"] - Staybnb</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet" />
    <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" rel="stylesheet" />
    <style>
        :root { --brand:#ff385c; }
        body { background:#f7f7f7; font-family:system-ui,-apple-system,"Segoe UI",sans-serif; }
        .brand { color:var(--brand); font-weight:700; text-decoration:none; font-size:1.3rem; }
        .btn-brand { background:var(--brand); color:#fff; border:0; } .btn-brand:hover { background:#e0314f; color:#fff; }
        .btn-outline-brand { border:1px solid var(--brand); color:var(--brand); } .btn-outline-brand:hover { background:var(--brand); color:#fff; }
        .sidebar { width:230px; min-height:calc(100vh - 57px); background:#fff; border-right:1px solid #eee; }
        .sidebar .nav-link { color:#444; border-radius:8px; margin:2px 8px; } .sidebar .nav-link.active, .sidebar .nav-link:hover { background:#ffe8ec; color:var(--brand); }
        .card { border:0; box-shadow:0 1px 4px rgba(0,0,0,.08); border-radius:14px; }
        .prop-img { aspect-ratio:4/3; object-fit:cover; border-radius:14px; width:100%; }
        .stat { font-size:1.8rem; font-weight:700; }
        .heart { position:absolute; top:10px; right:10px; background:rgba(255,255,255,.9); border:0; border-radius:50%; width:34px; height:34px; }
    </style>
</head>
<body>
<nav class="navbar bg-white border-bottom px-3" style="height:57px">
    <a class="brand" asp-controller="Home" asp-action="Index"><i class="bi bi-house-heart-fill"></i> staybnb@(isHost ? " host" : isAdmin ? " admin" : "")</a>
    @if (!side)
    {
        <form class="d-none d-md-flex mx-auto" method="get" asp-controller="Properties" asp-action="Index">
            <div class="input-group rounded-pill border" style="max-width:360px">
                <input name="city" class="form-control border-0 rounded-start-pill" placeholder="Search by city" />
                <button class="btn btn-brand rounded-pill m-1"><i class="bi bi-search"></i></button>
            </div>
        </form>
    }
    <div class="d-flex align-items-center gap-2 ms-auto">
        @if (!side)
        {
            @if (User.Identity.IsAuthenticated && isGuest)
            {
                <a class="btn btn-link text-dark text-decoration-none" asp-controller="Guest" asp-action="Applications">Host Application Status</a>
                <a class="btn btn-link text-dark text-decoration-none" asp-controller="Guest" asp-action="Apply">Become a Host</a>
            }
            else if (!User.Identity.IsAuthenticated)
            {
                <a class="btn btn-link text-dark text-decoration-none" asp-controller="Guest" asp-action="Apply">Become a Host</a>
            }
        }
        @if (User.Identity.IsAuthenticated)
        {
            @await Component.InvokeAsync("NavCounts")
            <div class="dropdown">
                <button class="btn btn-outline-secondary rounded-pill dropdown-toggle" data-bs-toggle="dropdown"><i class="bi bi-person-circle"></i> @User.Identity.Name</button>
                <ul class="dropdown-menu dropdown-menu-end">
                    @if (isGuest)
                    {
                        <li><a class="dropdown-item" asp-controller="Guest" asp-action="Bookings">My Bookings</a></li>
                        <li><a class="dropdown-item" asp-controller="Guest" asp-action="Wishlist">Wishlist</a></li>
                    }
                    <li><a class="dropdown-item" asp-controller="Messages" asp-action="Index">Messages</a></li>
                    <li><a class="dropdown-item" asp-controller="Notifications" asp-action="Index">Notifications</a></li>
                    <li><hr class="dropdown-divider" /></li>
                    <li><form asp-controller="Account" asp-action="Logout" method="post"><button class="dropdown-item text-danger">Log out</button></form></li>
                </ul>
            </div>
        }
        else
        {
            <a class="btn btn-outline-brand" asp-controller="Account" asp-action="Login">Log in</a>
            <a class="btn btn-brand" asp-controller="Account" asp-action="Register">Sign up</a>
        }
    </div>
</nav>
<div class="d-flex">
    @if (isHost)
    {
        <aside class="sidebar pt-3">
            <nav class="nav flex-column">
                <a class="nav-link @Active("/Host/Dashboard")" asp-controller="Host" asp-action="Dashboard"><i class="bi bi-pie-chart-fill"></i> Dashboard</a>
                <a class="nav-link @Active("/Host/Properties")" asp-controller="Host" asp-action="Properties"><i class="bi bi-house-fill"></i> My Properties</a>
                <a class="nav-link @Active("/Host/Bookings")" asp-controller="Host" asp-action="Bookings"><i class="bi bi-calendar-check"></i> Booking Requests</a>
                <a class="nav-link @Active("/Host/CheckIn")" asp-controller="Host" asp-action="CheckIns"><i class="bi bi-person-vcard"></i> Guest Check-ins</a>
                <a class="nav-link @Active("/Host/Earnings")" asp-controller="Host" asp-action="Earnings"><i class="bi bi-cash-stack"></i> Earnings</a>
                <a class="nav-link @Active("/Host/Reviews")" asp-controller="Host" asp-action="Reviews"><i class="bi bi-star-fill"></i> Reviews</a>
                <a class="nav-link @Active("/Messages")" asp-controller="Messages" asp-action="Index"><i class="bi bi-envelope-fill"></i> Messages</a>
                <a class="nav-link @Active("/Notifications")" asp-controller="Notifications" asp-action="Index"><i class="bi bi-bell-fill"></i> Notifications</a>
            </nav>
        </aside>
    }
    else if (isAdmin)
    {
        <aside class="sidebar pt-3">
            <nav class="nav flex-column">
                <a class="nav-link @Active("/Admin/Dashboard")" asp-controller="Admin" asp-action="Dashboard"><i class="bi bi-pie-chart-fill"></i> Dashboard</a>
                @if (User.IsInRole("SuperAdmin"))
                {
                    <a class="nav-link @Active("/Admin/Users")" asp-controller="Admin" asp-action="Users"><i class="bi bi-people-fill"></i> Users</a>
                }
                <a class="nav-link @Active("/Admin/Application")" asp-controller="Admin" asp-action="Applications"><i class="bi bi-file-earmark-text"></i> Host Requests</a>
                <a class="nav-link @Active("/Admin/Bookings")" asp-controller="Admin" asp-action="Bookings"><i class="bi bi-calendar-check"></i> Bookings</a>
                <a class="nav-link @Active("/Admin/Properties")" asp-controller="Admin" asp-action="Properties"><i class="bi bi-house-fill"></i> Properties</a>
                <a class="nav-link @Active("/Messages")" asp-controller="Messages" asp-action="Index"><i class="bi bi-envelope-fill"></i> Messages</a>
                <a class="nav-link @Active("/Notifications")" asp-controller="Notifications" asp-action="Index"><i class="bi bi-bell-fill"></i> Notifications</a>
                <a class="nav-link @Active("/Admin/ActivityLogs")" asp-controller="Admin" asp-action="ActivityLogs"><i class="bi bi-clock-history"></i> Activity Logs</a>
            </nav>
        </aside>
    }
    <main class="flex-grow-1 p-3 p-md-4" style="min-width:0">
        @if (TempData["Success"] != null) { <div class="alert alert-success alert-dismissible fade show">@TempData["Success"]<button class="btn-close" data-bs-dismiss="alert"></button></div> }
        @if (TempData["Error"] != null) { <div class="alert alert-danger alert-dismissible fade show">@TempData["Error"]<button class="btn-close" data-bs-dismiss="alert"></button></div> }
        @RenderBody()
    </main>
</div>
<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
@await RenderSectionAsync("Scripts", required: false)
</body>
</html>
