@model List<UserRowVM>
@{ ViewData["Title"] = "Users"; }
<h3>User Management <small class="text-muted fs-6">(SuperAdmin)</small></h3>
<form method="get" class="d-flex gap-2 mb-3" style="max-width:420px"><input name="q" value="@ViewBag.Query" class="form-control" placeholder="Search name or email" /><button class="btn btn-brand">Search</button></form>
<div class="card p-3"><table class="table align-middle mb-0"><thead><tr><th>Name</th><th>Email</th><th>Roles</th><th></th></tr></thead><tbody>
@foreach (var r in Model)
{
    <tr><td>@r.User.FullName</td><td>@r.User.Email</td><td>@foreach (var role in r.Roles) { <span class="badge bg-secondary me-1">@role</span> }</td>
        <td class="text-end">@if (r.Roles.Contains(Roles.Guest)) { <form asp-action="Promote" method="post" onsubmit="return confirm('Promote this Guest to Admin?')"><input type="hidden" name="userId" value="@r.User.Id" /><button class="btn btn-sm btn-outline-brand">Promote to Admin</button></form> }</td></tr>
}
</tbody></table></div>
