@model List<HostApplication>
@{ ViewData["Title"] = "Host requests"; var status = ViewBag.Status as string; }
<h3>Host / Property Applications</h3>
<div class="mb-3 d-flex gap-2">@foreach (var s in new[] { "Pending", "Approved", "Rejected", "All" }) { <a class="btn btn-sm @(status == s ? "btn-brand" : "btn-light")" asp-action="Applications" asp-route-status="@s">@s</a> }</div>
<div class="card p-3"><table class="table align-middle mb-0"><thead><tr><th>Applicant</th><th>Property</th><th>Date</th><th>Status</th><th></th></tr></thead><tbody>
@foreach (var a in Model) { <tr><td>@a.ApplicationUser.FullName<div class="small text-muted">@a.ApplicationUser.Email</div></td><td>@a.Property.Title<div class="small text-muted">@a.Property.City</div></td><td>@a.AppliedAt.ToString("yyyy-MM-dd")</td><td><span class="badge @Ui.Badge(a.Status)">@a.Status</span></td><td><a class="btn btn-sm btn-outline-brand" asp-action="Application" asp-route-id="@a.Id">Review</a></td></tr> }
</tbody></table>@if (!Model.Any()) { <p class="text-muted m-2">Nothing here.</p> }</div>
